{
  "extends": [
    "stylelint-config-standard"
  ],
  "rules": {
    "import-notation": "string",
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "config",
          "plugin",
          "theme",
          "utility",
          "variant",
          "custom-variant",
          "source",
          "apply"
        ]
      }
    ],
    "function-no-unknown": [
      true,
      {
        "ignoreFunctions": [
          "theme"
        ]
      }
    ]
  }
}
